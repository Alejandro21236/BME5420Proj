import argparse
def set_seed(seed):
    random.seed(seed)
    np.random.seed(seed)
    t.manual_seed(seed)
    t.cuda.manual_seed_all(seed)

ground_truth = pd.read_csv("groundtruth.csv")
path1 = "..." #anonymized, path to univ2 embeddings.

#Create dataset based on groundtruth and gather cases from path1
#collagen_IV,collagen_VI,fibrillar_collagen,fibronectin,laminin,osteopontin,tenascin_C,thrombospondin,vitronectin
predicted_columns = ["collagen_IV","collagen_VI", "fibrillar_collagen", "fibronectin", "laminin", "osteopontin", "tenascin_C", "thrombospondin", "vitronectin"]

DEVICE = "cuda"
EPOCHS = 20
LR = 1e-4
BATCH_SIZE = 1
MAX_PATCHES = 2048
SEED = 42

def compute_regression_metrics(ytrue, ypred):
    mse = mean_squared_error(ytrue,ypred)
    mae = mean_absolute_error(ytrue,ypred)
    r2 = r2_score(ytrue,ypred)
    pearsoncorr, _ = pearsonr(ytrue, ypred)
    spearmancorr, _ = spearmanr(ytrue,ypred)
    return mse, mae,r2, pearsoncorr, spearmancorr

class Dataset(t.utils.data.Dataset):
    def __init__(self, ground_truth, path1):
        file_exists = ground_truth["slide_id"].apply(
            lambda slide_id: (path.Path(path1) / f"{slide_id}.npy").is_file()
        )

        missing_slides = ground_truth.loc[~file_exists, "slide_id"]

        for slide_id in missing_slides:
            print(f"Skipping missing embedding file: {slide_id}.npy")

        ground_truth = ground_truth.loc[file_exists].copy()
        self.ground_truth = ground_truth
        self.path1 = path.Path(path1)
        self.slide_ids = ground_truth["slide_id"].values
        self.case_ids = ground_truth["case_id"].values
        self.labels = ground_truth[predicted_columns].values
        self.max_patches = MAX_PATCHES
    def __len__(self):
        return len(self.slide_ids)
    def __getitem__(self, idx):
        row = self.ground_truth.iloc[idx]
        case = row['slide_id']
        embed_path = self.path1 / f"{case}.npy"
        if embed_path.exists():
            data = np.load(embed_path, allow_pickle = True).item()
            coords = list(data.keys())
            target = self.labels[idx]
            patches = []
            for coord in coords:
                coord_0, coord_1 = coord
                patch = data[coord]["patch_embeddings"]
                if len(patches) < self.max_patches:
                    patch = np.asarray(
                        patch,
                        dtype=np.float32
                    )
                    patches.append(patch)
            patch = np.asarray(patches,dtype=np.float32) 
        return t.from_numpy(patch), t.tensor(target.astype(np.float32), dtype=t.float32), case
    
#GAN w/attention model
def edge_index_cosine_similarity(x, threshold = 0.5):
    x_normalized = F.normalize(x, p=2, dim=1, eps=1e-8)
    similarity = x_normalized @ x_normalized.t()
    edge_index = t.nonzero(similarity > threshold).t().contiguous()
    return edge_index
class Model(nn.Module):
    def __init__(self, input_dim = 1536, hidden_dim = 256, output_dim = 9):
        super(Model, self).__init__()
        self.conv1 = GATConv(input_dim, hidden_dim)
        self.conv2 = GATConv(hidden_dim, hidden_dim)
        self.mlp = nn.Sequential(nn.Linear(hidden_dim, hidden_dim), nn.ReLU(), nn.Linear(hidden_dim, output_dim))
        self.attention = nn.MultiheadAttention(hidden_dim, num_heads = 4)
        self.decoder = nn.Sequential(nn.Linear(hidden_dim, hidden_dim), nn.ReLU(), nn.Dropout(0.5), nn.Linear(hidden_dim, output_dim))
    def forward(self, x, edge_index):
        x = self.conv1(x, edge_index)
        x = F.relu(x)
        x = self.conv2(x, edge_index)
        x = F.relu(x)
        x = x.unsqueeze(1)
        x, _ = self.attention(x,x,x)
        x = x.squeeze(1)
        x= x.mean(dim=0)
        x = self.decoder(x)
        return x 

def train_model(model, loader, optimizer = None):
    training = optimizer is not None
    loss_fn = nn.MSELoss()
    model.train(training)
    losses = []
    predictions, targets, cases = [],[],[]
    for patch, target, case in loader:
        patch = patch.squeeze(0).to(DEVICE)
        target = target.squeeze(0).float().to(DEVICE)
        edge_index = edge_index_cosine_similarity(patch)
        if training:
            optimizer.zero_grad()
        with t.set_grad_enabled(training):
            output = model(patch, edge_index)
            loss = loss_fn(output, target)
            if training:
                loss.backward()
                optimizer.step()
        losses.append(float(loss.detach().cpu()))
        predictions.append(output.detach().cpu().numpy())
        targets.append(target.detach().cpu().numpy())
        cases.extend(case)
    return (
        float(np.mean(losses)),
        np.asarray(targets),
        np.asarray(predictions),
        cases 
    )
    
def evaluate_model(model, loader):
    return train_model(model, loader, optimizer = None)

def save_model(model, path):
    t.save(model.state_dict(), path)

#use the 5 folds and test/train/val splits in the groundtruth.csv
def main():
    set_seed(SEED)
    parser = argparse.ArgumentParser()
    parser.add_argument("--fold", type = int, required = True, choices = range(1,6), help = "1-5")
    args = parser.parse_args()
    output_dir = path.Path("results")
    output_dir.mkdir(parents=True, exist_ok = True)
    
    grouped = ground_truth.groupby("fold")
    for fold, fold_data in grouped:
        if fold != args.fold:
            continue
        print("Fold {fold}")
        train_data =  fold_data[fold_data["split"] == "train"]
        val_data =  fold_data[fold_data["split"] == "val"]
        test_data =  fold_data[fold_data["split"] == "test"]
        print(f"Training slides:   {len(train_data)}")
        print(f"Validation slides: {len(val_data)}")
        print(f"Test slides:       {len(test_data)}")
        train_dataset = Dataset(train_data, path1)
        val_dataset = Dataset(val_data, path1)
        test_dataset = Dataset(test_data, path1)
        train_loader = t.utils.data.DataLoader(train_dataset, batch_size = BATCH_SIZE, shuffle = True )
        val_loader = t.utils.data.DataLoader(val_dataset, batch_size = BATCH_SIZE, shuffle = False )
        test_loader = t.utils.data.DataLoader(test_dataset, batch_size = BATCH_SIZE, shuffle = False )
        model = Model(input_dim = 1536, hidden_dim = 256, output_dim = 9).to(DEVICE)
        optimizer = t.optim.Adam(model.parameters(), lr = LR)
        best_val_loss = float("inf")
        best_epoch = None
        best_model_state = None
        history = []
        for epoch in range(EPOCHS):
            train_loss, _,_,_ = train_model(model,train_loader, optimizer)
            val_loss, _,_,_ = evaluate_model(model, val_loader)
            print(f"Epoch {epoch +1}/{EPOCHS}")
            print(f"Train Loss = {train_loss:.6f} ")
            print(f"val Loss = {val_loss:.6f} ")
            history.append({"fold": fold, "epoch":epoch+1, "train_loss": train_loss, "val_loss": val_loss})
            if val_loss < best_val_loss:
                best_val_loss = val_loss
                best_epoch = epoch+1
                best_model_state = copy.deepcopy(model.state_dict())
                
        print(f"best epoch: {best_epoch}")
        
        model.load_state_dict(best_model_state)
        test_loss, test_targets, test_predictions, test_slides = evaluate_model(model, test_loader)
        print(f"Test Loss: {test_loss}")
        model_path = output_dir / f"fold_{fold}_best_model.pt"
        save_model(model, model_path)
        history_path = output_dir / f"fold_{fold}_history.csv"
        pd.DataFrame(history).to_csv(history_path, index = False)
        prediction_data = {"slide_id":test_slides}
        for i, column in enumerate(predicted_columns):
            prediction_data[f"{column}_true"] = test_targets[:,i]
            prediction_data[f"{column}_predicted"] = test_predictions[:,i]
        prediction_path = output_dir / f"fold_{fold}_predictions.csv"
        pd.DataFrame(prediction_data).to_csv(prediction_path, index =False)
        metrics_rows = []
        for i, column in enumerate(predicted_columns):
            mse,mae, r2, pearson, spearman = compute_regression_metrics(test_targets[:,i], test_predictions[:,i])
        
            metrics_rows.append({
                "fold": fold,
                "column": column,
                "mse": mse,
                "mae": mae,
                "r2": r2,
                "pearson": pearson,
                "spearman": spearman,
            })
        metrics_path = output_dir / f"fold_{fold}_testicles.csv"
        pd.DataFrame(metrics_rows).to_csv(metrics_path, index =False)
            
if __name__ == "__main__":
    main()
